{
  "id": "d11_memory_pruned_dp2tp8_hicache",
  "description": "Server-ready memory sample for the pruned model with DP2 TP8 and stage2 HiCache settings.",
  "profile": "stage2_hicache",
  "server": {
    "model": {
      "kind": "pruned",
      "env": "PRUNED_MODEL_PATH",
      "default_path": "/home/qwen3.5-pruned-models/Qwen3.5-122B-A10B-REAP-20-text-only"
    }
  },
  "router": {
    "enabled": false
  },
  "proxy": {
    "enabled": false
  },
  "client": {
    "enabled": false
  },
  "samplers": {
    "loads": {
      "enabled": true,
      "interval": 5,
      "include": "all"
    }
  }
}
