{
  "id": "07_admission_dp8tp8_hicache",
  "description": "Case 06 plus dynamic admission control.",
  "profile": "stage2_hicache",
  "server": {
    "dp_size": 8,
    "enable_dp_attention": true
  },
  "router": {
    "port": 30001
  },
  "proxy": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 30000,
