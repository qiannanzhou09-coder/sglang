{
  "id": "08_admission_pruned_dp2tp8_hicache_ratio4_kvfp8",
  "description": "Case 04 active-session admission plus FP8 KV cache.",
  "profile": "stage2_hicache",
  "server": {
    "model": {
      "kind": "pruned",
      "env": "PRUNED_MODEL_PATH",
      "default_path": "/home/qwen3.5-pruned-models/Qwen3.5-122B-A10B-REAP-20-text-only"
    },
    "hicache": {
      "ratio": "4"
    },
    "kv_cache_dtype": "fp8_e4m3"
  },
  "router": {
    "port": 30001
  },
  "proxy": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 30000,
    "policy": "passthrough_router",
    "max_active_sessions": 64,
    "session_idle_timeout": 7200,
    "dynamic_admission": true,
    "dynamic_min_inflight_requests": 16,
    "dynamic_initial_inflight_requests": 64,
    "dynamic_max_inflight_requests": 256,
    "dynamic_control_interval": 60
  }
}
